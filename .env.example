LLM_CHAT_COMPLETIONS_URL=https://your-openai-compatible-provider.example/v1/chat/completions
LLM_RESPONSES_URL=https://your-openai-provider.example/v1/responses
LLM_PROVIDER_PROTOCOL=openai-chat-completions
LLM_API_KEY=replace-with-your-key
LLM_MODELS=your-model-id
LLM_STREAM=true
LLM_TIMEOUT_MS=120000
LLM_RETRY_COUNT=2
