# OpenAI-compatible endpoint configuration
# Do not commit real provider URLs, API keys, or model IDs.
#
# These variables are the first-boot / headless compatibility entry: the
# server seeds its model registry from them when no model profiles exist yet.
# The in-app 模型配置中心 manages any number of additional providers and
# model profiles — secrets stay in this file, the non-secret profile data
# lives in data/model-settings.json (both gitignored).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Comma-separated model IDs available in the create-room dialog. Different
# characters can be assigned different models (round-robin by selection order);
# one model id for everyone is fine too.
SOCIETY_MODELS=

# Per-model context windows in tokens: "modelIdA:1000000,modelIdB:262144".
# Agents with long-window models keep more conversation before compaction;
# unknown models fall back to 256k.
SOCIETY_MODEL_CONTEXTS=

# Fraction of the context window at which an agent's session history is
# compressed into a digest (default 0.75). The multi-level context policy
# (watch/soft/deep/emergency/hard-guard thresholds) is managed per model
# profile; this variable is the legacy single-threshold fallback.
SOCIETY_CONTEXT_COMPACT_RATIO=0.75

# Where the Society Season history is persisted (default data/season.json).
# The file holds private character memories and must stay out of version
# control — the default path is already gitignored.
SOCIETY_SEASON_FILE=

SOCIETY_AGENT_TURN_TIMEOUT_MS=300000
SOCIETY_HUMAN_TURN_TIMEOUT_MS=1800000
SOCIETY_AGENT_MAX_TURNS=10

# Process-wide provider backpressure: how many agent model activations may run
# concurrently ACROSS ALL rooms (default 8). Smaller values protect a small
# VPS and provider rate limits at the cost of wall-clock speed.
SOCIETY_MAX_CONCURRENT_ACTIVATIONS=8
PORT=8787
HOST=127.0.0.1

# Exa search API key (agent tooling, not used by server runtime)
EXA_API_KEY=

# Where finished games are persisted when their creator opted in at creation
# ("保存对局"). Default: data/archives. Contains the omniscient end state and
# opens only for the room owner or the operator token.
SOCIETY_ARCHIVE_DIR=
