# First boot only. Additional providers and models are managed in Settings.
# Secrets belong in .env.local; non-secret profiles use data/model-settings.json.
OPENAI_API_KEY=
OPENAI_BASE_URL=
SOCIETY_MODELS=gpt-6-luna
SOCIETY_API_MODE=responses
# Optional registered context-window metadata: modelIdA:32768,modelIdB:131072
SOCIETY_MODEL_CONTEXTS=gpt-6-luna:256000

# Optional named credentials for profiles / research retrieval.
# Set the Cardinalize profile's apiKeyRef to env:CARDINALIZE_API_KEY.
CARDINALIZE_API_KEY=
# Current research search provider. Keep the real value in .env.local.
EXA_API_KEY=
# Retained for historical research scripts/configuration.
PARALLEL_API_KEY=

PORT=8787
HOST=127.0.0.1
# Required when binding outside loopback.
SOCIETY_OPERATOR_TOKEN=
SOCIETY_DATABASE_FILE=data/society.sqlite
SOCIETY_MODEL_SETTINGS_FILE=data/model-settings.json
SOCIETY_CHARACTERS_FILE=data/characters.json
# Read-only legacy archives.
SOCIETY_ARCHIVE_DIR=data/archives
SOCIETY_SHUTDOWN_GRACE_MS=15000
SOCIETY_MODEL_PROTOCOL_TIMEOUT_MS=120000
