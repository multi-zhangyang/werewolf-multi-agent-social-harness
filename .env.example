ANTHROPIC_API_KEY=replace-with-your-anthropic-key
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=1024
AGENT_TEMPERATURE=0.7
MATCH_MAX_TRANSITIONS=
MATCH_TIMEOUT_MS=5400000
TOURNAMENT_GAMES=3
TOURNAMENT_TIMEOUT_MS=600000
TOURNAMENT_ARTIFACT_BASE_DIR=.artifacts/tournaments
MATCH_ARTIFACT_BASE_DIR=.artifacts/matches
CHECKPOINT_ARTIFACT_BASE_DIR=.artifacts/checkpoints
EXPERIMENT_RUN_BASE_DIR=.artifacts/experiment-runs
COMPARISON_ARTIFACT_BASE_DIR=.artifacts/comparisons
PORT=8787
