# OpenAI-compatible endpoint configuration
# Do not commit real provider URLs, API keys, or model IDs.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Comma-separated model IDs available in the create-room dialog. Different
# characters can be assigned different models (round-robin by selection order);
# one model id for everyone is fine too.
SOCIETY_MODELS=

# Per-model context windows in tokens: "modelIdA:1000000,modelIdB:262144".
# Agents with long-window models keep more conversation before compaction;
# unknown models fall back to 256k.
SOCIETY_MODEL_CONTEXTS=

# Fraction of the context window at which an agent's session history is
# compressed into a digest (default 0.75).
SOCIETY_CONTEXT_COMPACT_RATIO=0.75

SOCIETY_AGENT_TURN_TIMEOUT_MS=300000
SOCIETY_HUMAN_TURN_TIMEOUT_MS=1800000
SOCIETY_AGENT_MAX_TURNS=10
PORT=8787
HOST=127.0.0.1
