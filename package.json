{
  "name": "society-multi-agent-worlds",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Live multi-agent social worlds powered by the OpenAI Agents SDK.",
  "homepage": "https://github.com/multi-zhangyang/werewolf-multi-agent-social-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multi-zhangyang/werewolf-multi-agent-social-harness.git"
  },
  "bugs": {
    "url": "https://github.com/multi-zhangyang/werewolf-multi-agent-social-harness/issues"
  },
  "keywords": [
    "multi-agent",
    "openai-agents-sdk",
    "social-simulation",
    "social-deduction",
    "game-theory",
    "deception",
    "werewolf",
    "typescript",
    "react"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs watch src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "server": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:replay": "vitest run tests/replay",
    "test": "vitest run",
    "society:server": "npm run server",
    "doctor": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/doctor.ts",
    "study": "node --env-file-if-exists=.env.local --import tsx scripts/study.ts",
    "study:relationship": "node --env-file-if-exists=.env.local --import tsx scripts/relationship-probe.ts",
    "study:personality": "node --env-file-if-exists=.env.local --import tsx scripts/personality-probe.ts",
    "study:psychology": "node --env-file-if-exists=.env.local --import tsx scripts/psychology-probe.ts",
    "test:ui": "node --import tsx scripts/ui-v2.mjs",
    "test:ui:psychology": "node --import tsx scripts/ui-psychology.mjs",
    "study:hybrid": "node --env-file-if-exists=.env.local --import tsx scripts/hybrid-study.ts",
    "test:ui:hybrid": "node --import tsx scripts/ui-hybrid.mjs",
    "test:ui:foundation": "node --import tsx scripts/ui-foundation.mjs",
    "study:playability": "node --env-file-if-exists=.env.local --import tsx scripts/playability-probe.ts",
    "test:ui:partners": "node --import tsx scripts/ui-partners.mjs",
    "study:partners": "node --env-file-if-exists=.env.local --import tsx scripts/partners-live.ts",
    "study:partners:validation": "node --env-file-if-exists=.env.local --import tsx scripts/partners-validation.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@openai/agents": "^0.16.0",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@shadcn/react": "^0.3.1",
    "@streamdown/cjk": "^1.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.3",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "express": "^5.2.1",
    "lucide-react": "^1.31.0",
    "motion": "^14.0.0",
    "openai": "^7.4.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.8.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2",
    "vite": "^8.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shadcn/helpers": "^0.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "ai": "^7.0.127",
    "concurrently": "^9.2.4",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "puppeteer-core": "^25.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
