{
  "name": "society-multi-agent-worlds",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Live multi-agent social worlds powered by the OpenAI Agents SDK.",
  "homepage": "https://github.com/multi-zhangyang/werewolf-multi-agent-social-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multi-zhangyang/werewolf-multi-agent-social-harness.git"
  },
  "bugs": {
    "url": "https://github.com/multi-zhangyang/werewolf-multi-agent-social-harness/issues"
  },
  "keywords": [
    "multi-agent",
    "openai-agents-sdk",
    "social-simulation",
    "social-deduction",
    "game-theory",
    "deception",
    "werewolf",
    "typescript",
    "react"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs watch src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "server": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:recovery": "vitest run tests/recovery",
    "test:security": "vitest run tests/security",
    "test:replay": "vitest run tests/replay",
    "test:chaos": "vitest run tests/chaos",
    "test": "npm run test:unit && npm run test:contract && npm run test:integration",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run test:recovery && npm run test:security && npm run test:replay && npm run test:chaos && npm run build",
    "society:server": "npm run server"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@openai/agents": "^0.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.4",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
