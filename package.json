{
  "name": "werewolf-multi-agent-arena",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Replayable and evaluable multi-agent adversarial society harness with Werewolf as the first domain adapter.",
  "homepage": "https://github.com/multi-zhangyang/werewolf-multi-agent-social-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multi-zhangyang/werewolf-multi-agent-social-harness.git"
  },
  "bugs": {
    "url": "https://github.com/multi-zhangyang/werewolf-multi-agent-social-harness/issues"
  },
  "keywords": [
    "multi-agent",
    "multi-agent-systems",
    "agent-harness",
    "agent-based-modeling",
    "ai-agents",
    "llm-agents",
    "social-simulation",
    "social-deduction",
    "adversarial-agents",
    "hidden-information",
    "werewolf-game",
    "llm-evaluation",
    "agent-evaluation",
    "deterministic-replay",
    "typescript",
    "react",
    "research-tool"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs watch src/server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/checkBundleBudget.mjs",
    "server": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/server/index.ts",
    "test": "vitest run tests",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:fixture-server": "node --import tsx e2e/cockpitFixtureServer.ts",
    "test:live-e2e": "playwright test --config=playwright.live.config.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "ci": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "agent:probe": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/scripts/probe.ts",
    "arena:match": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/scripts/runMatch.ts",
    "arena:tournament": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/scripts/runTournament.ts",
    "arena:matrix": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/scripts/runMatrix.ts",
    "arena:auction": "node --import tsx src/scripts/runSealedBidAuction.ts",
    "arena:replay": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/scripts/replayMatch.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@anthropic-ai/sdk": "^0.110.0",
    "@noble/hashes": "2.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "antd": "^6.5.0",
    "express": "^5.2.1",
    "openai": "^6.45.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "^4.23.0",
    "vite": "^8.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.0.16"
  }
}
